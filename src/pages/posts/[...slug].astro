---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, postUrl, withBase, categoryLabel, formatDate } from '../../lib/blog';
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({ params: { slug: post.id }, props: { post } }));
}
interface Props { post: CollectionEntry<'posts'>; }
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const posts = await getPosts();
const index = posts.findIndex((item) => item.id === post.id);
const next = posts[index + 1];
---
<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article">
    <a class="back-link" href={`${withBase('posts/')}?category=${post.data.category}`}><span aria-hidden="true">←</span> {categoryLabel(post.data.category)}</a>
    <header class="article-heading">
      {post.data.example && <p class="example-notice">예시 글 · 화면과 글 형식을 확인하기 위한 샘플입니다.</p>}
      <h1>{post.data.title}</h1>
      <div class="article-meta"><time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>{post.data.updatedDate && <span>수정 {formatDate(post.data.updatedDate)}</span>}</div>
      {post.data.description && <p class="article-description">{post.data.description}</p>}
      {post.data.tags.length > 0 && <ul class="article-tags" aria-label="태그">{post.data.tags.map((tag) => <li><a href={`${withBase('posts/')}?q=${encodeURIComponent(tag)}`}>#{tag}</a></li>)}</ul>}
    </header>
    {toc.length >= 2 && <details class="article-toc"><summary>목차</summary><ol>{toc.map((heading) => <li class:list={{ 'toc-sub': heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}</ol></details>}
    <div class="prose"><Content /></div>
    <div class="article-end"><a class="text-link" href={withBase('posts/')}>← 모든 기록</a><button class="quiet-button" id="copy-url" type="button">링크 복사</button><span id="copy-status" class="sr-only" role="status"></span></div>
    {next && <a class="next-post" href={postUrl(next)}><span>다음 기록</span><strong>{next.data.title}</strong><span aria-hidden="true">↗</span></a>}
    <Comments />
  </article>
</BaseLayout>
<script>
  const copy = document.querySelector<HTMLButtonElement>('#copy-url')!;
  copy.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status')!;
    try {
      await navigator.clipboard.writeText(window.location.href);
      copy.textContent = '복사 완료';
      status.textContent = '글 주소를 복사했습니다.';
    } catch { copy.textContent = '주소창에서 복사해 주세요'; }
    window.setTimeout(() => { copy.textContent = '링크 복사'; }, 2500);
  });
  document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.textContent = '복사';
    button.setAttribute('aria-label', '코드 복사');
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || '');
        button.textContent = '완료';
      } catch { button.textContent = '직접 복사해 주세요'; }
      window.setTimeout(() => { button.textContent = '복사'; }, 2000);
    });
    pre.appendChild(button);
  });
</script>
