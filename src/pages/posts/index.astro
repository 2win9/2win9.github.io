---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, categories } from '../../lib/blog';
const posts = await getPosts();
---
<BaseLayout title="모든 기록">
  <header class="page-heading"><p class="eyebrow">ARCHIVE</p><h1>모든 기록<span class="heading-count">{posts.length}</span></h1></header>
  <div class="archive-tools">
    <div class="category-filters" role="group" aria-label="글 분류">
      <button class="active" type="button" data-filter="all" aria-pressed="true">전체</button>
      {categories.map((category) => <button type="button" data-filter={category.id} aria-pressed="false">{category.label}</button>)}
    </div>
    <label class="search-field"><span class="sr-only">글 검색</span><span aria-hidden="true">⌕</span><input id="post-search" type="search" placeholder="제목, 태그로 검색" autocomplete="off" /></label>
  </div>
  <PostList posts={posts} detailed filterable />
  <p id="search-empty" class="search-empty" hidden>검색 결과가 없습니다.</p>
  <p class="results-count" id="results-count" aria-live="polite">{posts.length}개의 글</p>
</BaseLayout>
<script>
  const buttons = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
  const items = [...document.querySelectorAll<HTMLElement>('[data-post]')];
  const input = document.querySelector<HTMLInputElement>('#post-search')!;
  const empty = document.querySelector<HTMLElement>('#search-empty')!;
  const count = document.querySelector<HTMLElement>('#results-count')!;
  const url = new URL(window.location.href);
  const initial = url.searchParams.get('category') || 'all';
  let category = buttons.some((button) => button.dataset.filter === initial) ? initial : 'all';
  input.value = url.searchParams.get('q') || '';
  function filter() {
    const query = input.value.trim().toLocaleLowerCase('ko');
    let visible = 0;
    for (const item of items) {
      const matches = (category === 'all' || item.dataset.category === category)
        && (item.dataset.search || '').includes(query);
      item.hidden = !matches;
      if (matches) visible += 1;
    }
    for (const button of buttons) {
      const selected = button.dataset.filter === category;
      button.classList.toggle('active', selected);
      button.setAttribute('aria-pressed', String(selected));
    }
    empty.hidden = visible > 0;
    count.textContent = `${visible}개의 글`;
    const next = new URL(window.location.href);
    category === 'all' ? next.searchParams.delete('category') : next.searchParams.set('category', category);
    query ? next.searchParams.set('q', input.value.trim()) : next.searchParams.delete('q');
    window.history.replaceState(null, '', next);
  }
  buttons.forEach((button) => button.addEventListener('click', () => { category = button.dataset.filter!; filter(); }));
  input.addEventListener('input', filter);
  filter();
</script>
